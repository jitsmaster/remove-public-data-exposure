{
  "name": "remove-public-data-exposure",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "pnpm --filter @rpde/server dev",
    "dev:pwa": "pnpm --filter @rpde/pwa dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/gen-icons.mjs",
    "vapid": "pnpm --filter @rpde/server vapid",
    "pii-scan": "node scripts/pii-scan.mjs",
    "registry:data": "node scripts/import-badbool.mjs",
    "registry:vendor": "node scripts/vendor-badbool.mjs",
    "seed": "pnpm --filter @rpde/server seed"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
