# Orchestrator config. Copy to .env and fill in. NEVER commit .env.
PORT=8787

# Where SQLite lives. Job metadata only — no PII, see DESIGN.md §5.2.
DATA_DIR=./data

# Comma-separated allowed browser origins. The Cloudflare Pages origin plus local dev.
PWA_ORIGIN=http://localhost:5173

# Optional shared secret. If set, every request needs `Authorization: Bearer <token>`.
# Tailscale already keeps this off the public internet; this is defence in depth.
API_TOKEN=

# Generate with: pnpm --filter @rpde/server vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Must be a mailto: or https: URL identifying you as the push sender.
VAPID_SUBJECT=mailto:you@example.com
